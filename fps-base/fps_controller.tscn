[sub_resource type="GDScript" id="GDScript_j0767"]
script/source = "extends CharacterBody3D

@export var SPEED_DEFAULT : float = 5.0
@export var SPEED_SPRINTING : float = 12.0
@export var SPEED_CROUCH : float = 2.0
@export var TOGGLE_CROUCH : bool = true
@export var ACCELERATION : float = 0.1
@export var DECELERATION : float = 0.25
@export var JUMP_VELOCITY : float = 4.5
@export_range(5, 10, 0.1) var CROUCH_SPEED : float = 7.0
@export var MOUSE_SENSITIVITY : float = 0.5
@export var TILT_LOWER_LIMIT := deg_to_rad(-89.0)
@export var TILT_UPPER_LIMIT := deg_to_rad(89.0)
@export var CAMERA_CONTROLLER : Node3D
@export var ANIMATIONPLAYER : AnimationPlayer
@export var CROUCH_SHAPECAST : Node3D

var _speed : float
var _mouse_rotation : Vector3
var _rotation_input : float
var _tilt_input : float
var _player_rotation : Vector3
var _camera_rotation : Vector3
var _is_crouching : bool = false


func _ready():
	Global.player = self
	Input.mouse_mode = Input.MOUSE_MODE_CAPTURED
	_speed = SPEED_DEFAULT

	if CROUCH_SHAPECAST:
		CROUCH_SHAPECAST.add_exception(self)


func _input(event):
	if event.is_action_pressed(\"salir\"):
		get_tree().quit()

	if event is InputEventMouseMotion and Input.get_mouse_mode() == Input.MOUSE_MODE_CAPTURED:
		_rotation_input = -event.relative.x * MOUSE_SENSITIVITY
		_tilt_input = -event.relative.y * MOUSE_SENSITIVITY

	if TOGGLE_CROUCH:
		if event.is_action_pressed(\"agacharse\") and is_on_floor():
			_toggle_crouch()
	else:
		if event.is_action_pressed(\"agacharse\") and is_on_floor() and not _is_crouching:
			_set_crouching(true)
		elif event.is_action_released(\"agacharse\") and _is_crouching:
			_set_crouching(false)


func _physics_process(delta: float) -> void:
	Global.debug.add_property(\"MovementSpeed\", _speed, 1)
	Global.debug.add_property(
	\"CameraRotation\",
	Vector3(
		rad_to_deg(_mouse_rotation.x),
		rad_to_deg(_mouse_rotation.y),
		0
	),
	0
)
	
	# Agregar la gravedad y el chequeo anti-caída
	if not is_on_floor():
		var space_state = get_world_3d().direct_space_state
		
		var query = PhysicsRayQueryParameters3D.create(
			global_position + Vector3(0, 1, 0), 
			global_position + Vector3(0, -1000, 0)
		)
		var result = space_state.intersect_ray(query)
		
		if result.is_empty():
			# Congelamos solo la caída (eje Y) para no frenar tu movimiento en X/Z
			velocity.y = 0 
		else:
			velocity += get_gravity() * delta

	_update_camera(delta)
	_update_movement(delta)

	move_and_slide()


func _update_camera(delta):
	
	_mouse_rotation.x += _tilt_input * delta
	_mouse_rotation.x = clamp(_mouse_rotation.x, TILT_LOWER_LIMIT, TILT_UPPER_LIMIT)
	_mouse_rotation.y += _rotation_input * delta

	_player_rotation = Vector3(0.0, _mouse_rotation.y, 0.0)
	_camera_rotation = Vector3(_mouse_rotation.x, 0.0, 0.0)

	if CAMERA_CONTROLLER:
		CAMERA_CONTROLLER.transform.basis = Basis.from_euler(_camera_rotation)
		CAMERA_CONTROLLER.rotation.z = 0.0

	global_transform.basis = Basis.from_euler(_player_rotation)

	_rotation_input = 0.0
	_tilt_input = 0.0


func _update_movement(_delta):
	# Salto.
	if Input.is_action_just_pressed(\"ui_accept\") and is_on_floor() and not _is_crouching:
		velocity.y = JUMP_VELOCITY

	# Movimiento horizontal.
	# Buena práctica: reemplaza las acciones \"ui_*\" por acciones propias del juego.
	var input_dir := Input.get_vector(\"izquierda\", \"derecha\", \"adelante\", \"atras\")
	var direction := (transform.basis * Vector3(input_dir.x, 0, input_dir.y)).normalized()

	if direction:
		velocity.x = lerp(velocity.x, direction.x * _speed, ACCELERATION)
		velocity.z = lerp(velocity.z, direction.z * _speed, ACCELERATION)
	else:
		velocity.x = move_toward(velocity.x, 0, DECELERATION)
		velocity.z = move_toward(velocity.z, 0, DECELERATION)


func _toggle_crouch():
	if _is_crouching and (not CROUCH_SHAPECAST or not CROUCH_SHAPECAST.is_colliding()):
		_set_crouching(false)
	elif not _is_crouching:
		_set_crouching(true)


func _set_crouching(state: bool):
	if not ANIMATIONPLAYER:
		_is_crouching = state
		_speed = SPEED_CROUCH if state else SPEED_DEFAULT
		return

	if state:
		ANIMATIONPLAYER.play(\"Agacharse\", 0, CROUCH_SPEED)
		_speed = SPEED_CROUCH
	else:
		ANIMATIONPLAYER.play(\"Agacharse\", 0, -CROUCH_SPEED, true)
		_speed = SPEED_DEFAULT


func _on_animation_player_animation_started(anim_name):
	if anim_name == \"Agacharse\":
		_is_crouching = not _is_crouching
"

